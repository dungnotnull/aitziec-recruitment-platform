# Environment & Server
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# PostgreSQL Database (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/itziec?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & JWT
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long_example
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long_example
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=itziec_refresh
REFRESH_COOKIE_SAME_SITE=lax
REFRESH_COOKIE_SECURE=false

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# MinIO / S3 Object Storage (Local Infrastructure)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=itziec-cvs

# Mailpit / SMTP (Local Infrastructure)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ITZiec Recruitment <no-reply@itziec.com>"
